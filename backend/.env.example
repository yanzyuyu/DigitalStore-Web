APP_NAME="Digital Shop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (MySQL 8)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=digital_shop
DB_USERNAME=digital_shop
DB_PASSWORD=secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ---------------------------------------------------------------------------
# Session / Queue / Cache
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@digital-shop.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Auth / Sanctum
# ---------------------------------------------------------------------------
# Comma-separated list of stateful (cookie-authenticated) SPA domains.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
# Token lifetime in minutes. null = never expires.
SANCTUM_TOKEN_EXPIRATION=10080

# ---------------------------------------------------------------------------
# Payment
# ---------------------------------------------------------------------------
# Supported: manual | duitku | midtrans
PAYMENT_GATEWAY=manual
PAYMENT_EXPIRY_MINUTES=1440
PAYMENT_MANUAL_BANK_NAME="BCA"
PAYMENT_MANUAL_BANK_ACCOUNT="1234567890"
PAYMENT_MANUAL_BANK_HOLDER="PT Digital Shop Indonesia"
# Reject a webhook whose timestamp is older than this many seconds.
PAYMENT_WEBHOOK_TOLERANCE=300

# Duitku (used when PAYMENT_GATEWAY=duitku)
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_SANDBOX=true

# Midtrans (used when PAYMENT_GATEWAY=midtrans)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SANDBOX=true

# ---------------------------------------------------------------------------
# Business rules
# ---------------------------------------------------------------------------
# Platform commission taken from each sale, in percent (0-100).
MARKETPLACE_COMMISSION_PERCENT=10
# Maximum number of products a seller may publish (0 = unlimited).
SELLER_MAX_PRODUCTS=0
# Invoice number prefix, e.g. INV-20260101-8F3A2B1C.
INVOICE_PREFIX=INV

# ---------------------------------------------------------------------------
# Storage (private downloads)
# ---------------------------------------------------------------------------
DOWNLOAD_DISK=private
# Signed download URL lifetime, in minutes.
DOWNLOAD_LINK_EXPIRY_MINUTES=60

# ---------------------------------------------------------------------------
# Initial administrator (consumed by AdminUserSeeder; admins cannot self-register)
# ---------------------------------------------------------------------------
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@digital-shop.test
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Demo data (only seeded when APP_ENV=local and SEED_DEMO_DATA=true)
# ---------------------------------------------------------------------------
SEED_DEMO_DATA=false

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

VITE_APP_NAME="${APP_NAME}"
